APP_ENV=development
# Conexión Supabase en modo Transaction pooler (puerto 6543). Nunca commitees credenciales reales.
DATABASE_URL=postgresql://usuario:PON_TU_PASSWORD@db.PROYECTO.supabase.co:6543/postgres
SECRET_KEY=change-me-generate-a-strong-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_RESET_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","https://myfinanzas.vercel.app"]
AUTH_COOKIE_NAME=myfinanzas_token
# True solo en producción con HTTPS (emite cookie Secure + SameSite=None)
AUTH_COOKIE_SECURE=false