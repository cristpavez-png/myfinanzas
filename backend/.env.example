APP_ENV=development
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/myfinanzas
SECRET_KEY=change-me-generate-a-strong-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_RESET_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000"]
AUTH_COOKIE_NAME=myfinanzas_token
# True solo en producción con HTTPS (emite cookie Secure + SameSite=None)
AUTH_COOKIE_SECURE=false